{
  "name": "andresblanco-site",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Personal website and portfolio of Andrés Felipe Blanco Sierra — software engineering, backend, cloud, security.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "lint": "eslint .",
    "typecheck": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
