---
import RevealOnScroll from '../components/animations/RevealOnScroll';

interface Section {
  id: string;
  label: string;
  note?: string;
}

interface Props {
  title: string;
  year: string;
  summary: string;
  tags: string[];
  repo: string;
  metrics: string[];
  sections: Section[];
}

const { title, year, summary, tags, repo, metrics } = Astro.props;
---

<article class="mx-auto max-w-4xl px-6 pt-28 pb-20">
  <!-- header -->
  <header class="mb-12">
    <p class="tech-label--signal mb-4 flex items-center gap-2">
      <span aria-hidden="true">case study /</span>
      <span>{year}</span>
    </p>
    <h1 class="mb-5 font-mono text-3xl leading-tight tracking-tight text-fg sm:text-4xl">
      {title}
    </h1>
    <p class="mb-6 max-w-2xl text-lg leading-relaxed text-fg-muted">{summary}</p>
    <div class="mb-6 flex flex-wrap gap-2">
      {tags.map((t) => (
        <span class="border border-line bg-bg-elevated px-2.5 py-1 font-mono text-xs text-fg-dim">
          {t}
        </span>
      ))}
    </div>
    {metrics.length > 0 && (
      <div class="mb-6 flex flex-wrap gap-3">
        {metrics.map((m) => (
          <span class="border border-line bg-bg-inset px-3 py-1.5 font-mono text-xs text-ok">
            {m}
          </span>
        ))}
      </div>
    )}
    <a
      href={repo}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-2 font-mono text-sm text-fg-dim transition-colors hover:text-signal"
    >
      <span aria-hidden="true">⌥</span> github.com/{new URL(repo).pathname.slice(1)}
    </a>
  </header>

  <!-- body -->
  <RevealOnScroll>
    <div class="prose-custom">
      <slot />
    </div>
  </RevealOnScroll>

  <!-- prev/next -->
  <nav class="mt-16 border-t border-line pt-6 font-mono text-sm" aria-label="More projects">
    <a href="/projects" class="text-fg-dim transition-colors hover:text-signal">
      ← all projects
    </a>
  </nav>
</article>

<style>
  :global(.prose-custom) {
    color: var(--color-fg-muted);
  }
  :global(.prose-custom h2) {
    font-family: var(--font-mono);
    font-size: 1.125rem;
    color: var(--color-fg);
    letter-spacing: 0.02em;
    margin-top: 3rem;
    margin-bottom: 1rem;
    scroll-margin-top: 6rem;
  }
  :global(.prose-custom p) {
    line-height: 1.75;
    margin-bottom: 1rem;
  }
  :global(.prose-custom code) {
    font-family: var(--font-mono);
    font-size: 0.875em;
    color: var(--color-fg);
    background: var(--color-bg-inset);
    padding: 0.15em 0.4em;
    border-radius: 3px;
    border: 1px solid var(--color-line);
  }
  :global(.prose-custom pre) {
    background: var(--color-bg-inset);
    border: 1px solid var(--color-line);
    border-radius: 6px;
    padding: 1.25rem;
    overflow-x: auto;
    margin: 1.5rem 0;
    font-size: 0.875rem;
    line-height: 1.7;
  }
  :global(.prose-custom pre code) {
    background: transparent;
    border: none;
    padding: 0;
  }
  :global(.prose-custom ul) {
    list-style: none;
    margin: 1rem 0;
    padding: 0;
  }
  :global(.prose-custom ul li) {
    position: relative;
    padding-left: 1.5rem;
    margin-bottom: 0.5rem;
    line-height: 1.7;
  }
  :global(.prose-custom ul li::before) {
    content: '—';
    position: absolute;
    left: 0;
    color: var(--color-signal);
  }
  :global(.prose-custom strong) {
    color: var(--color-fg);
    font-weight: 600;
  }
</style>