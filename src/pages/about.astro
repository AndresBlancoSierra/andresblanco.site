---
import PageLayout from '../layouts/PageLayout.astro';
import { SITE, EDUCATION, DOMAINS, SKILLS, QUALITY_GUARANTEES, LANGUAGES, HONORS, PROJECTS } from '../lib/profile';
---

<PageLayout
  path="/about"
  title="About"
  description={`About ${SITE.name} — systems engineering student, builder and documenter of complete systems.`}
>
  <section class="mx-auto max-w-6xl px-6 pt-28">
    <p class="tech-label mb-4">about / who I am</p>
    <h1 class="mb-8 font-mono text-3xl tracking-tight text-fg sm:text-4xl">About</h1>
  </section>

  <section class="mx-auto max-w-6xl px-6 pb-16">
    <div class="grid gap-10 lg:grid-cols-5">
      <!-- narrative -->
      <div class="space-y-6 lg:col-span-3">
        <p class="text-lg leading-relaxed text-fg-muted">
          I'm a 7th-semester Systems Engineering student at <span class="text-fg">Universidad EAN</span> in
          Bogotá. I build systems end-to-end and I document how they work.
        </p>
        <p class="leading-relaxed text-fg-muted">
          My work spans the whole stack: C++ Linux drivers and Arduino firmware,
          Whisper/CLIP computer-vision pipelines in Python, FastAPI backends, and
          React 19 frontends. I treat my machine and the software around it as a
          system to be engineered — wallpapers that read an Obsidian vault, Telegram
          bots that run AI tasks, and systemd services that keep everything running.
        </p>
        <p class="leading-relaxed text-fg-muted">
          I publish consistently (16 public repositories, 6 featured), test what I
          build (198+ automated tests across main projects), and document decisions
          — architecture, trade-offs and troubleshooting.
        </p>

        <!-- domains as constellation prose -->
        <div class="panel mt-8 p-6">
          <p class="tech-label mb-4">areas of work</p>
          <ul class="space-y-3">
            {
              DOMAINS.map((d) => (
                <li class="flex items-baseline gap-3 font-mono text-sm">
                  <span class="text-signal">◆</span>
                  <span class="text-fg">{d.label}</span>
                  <span class="text-fg-dim">— {d.detail}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      <!-- side column: education, languages, honors -->
      <aside class="space-y-8 lg:col-span-2">
        <div>
          <h2 class="tech-label mb-3">education</h2>
          <div class="panel p-5">
            <p class="font-mono text-sm text-fg">B.S. Systems Engineering</p>
            <p class="mt-1 text-sm text-fg-dim">{EDUCATION.institution}</p>
            <p class="mt-1 font-mono text-xs text-fg-faint">
              2023 — 2027 (expected)
            </p>
            <p class="mt-3 text-sm leading-relaxed text-fg-dim">
              Student representative of the Faculty of Engineering; artistic
              excellence scholarship with the EAN Philharmonic Orchestra.
            </p>
          </div>
        </div>

        <div>
          <h2 class="tech-label mb-3">languages</h2>
          <ul class="space-y-2">
            {
              LANGUAGES.map((l) => (
                <li class="panel p-4">
                  <p class="font-mono text-sm text-fg">{l.language}</p>
                  <p class="mt-1 text-xs text-fg-dim">{l.level}</p>
                </li>
              ))
            }
          </ul>
        </div>

        <div>
          <h2 class="tech-label mb-3">honors</h2>
          <ul class="space-y-2">
            {
              HONORS.map((h) => (
                <li class="panel p-4">
                  <p class="font-mono text-sm text-fg">{h.title}</p>
                  {h.detail && <p class="mt-1 text-xs text-fg-dim">{h.detail}</p>}
                </li>
              ))
            }
          </ul>
        </div>
      </aside>
    </div>
  </section>

  <!-- skills -->
  <section class="border-t border-line">
    <div class="mx-auto max-w-6xl px-6 py-16">
      <p class="tech-label mb-8">skills / technology</p>
      <dl class="grid gap-px bg-line md:grid-cols-2">
        {
          SKILLS.map((group) => (
            <div class="bg-bg p-6">
              <dt class="font-mono text-xs tracking-widest text-signal uppercase">
                {group.label}
              </dt>
              <dd class="mt-3 text-sm leading-loose text-fg-dim">
                {group.details.join(' · ')}
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- how I work -->
  <section class="border-t border-line">
    <div class="mx-auto max-w-6xl px-6 py-16">
      <p class="tech-label mb-8">engineering practice</p>
      <ul class="space-y-px">
        {
          QUALITY_GUARANTEES.map((g, i) => (
            <li class="flex gap-4 py-3">
              <span class="w-8 shrink-0 font-mono text-sm text-fg-faint">
                {String(i + 1).padStart(2, '0')}
              </span>
              <span class="text-sm leading-relaxed text-fg-muted">{g}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- selected work -->
  <section class="border-t border-line">
    <div class="mx-auto max-w-6xl px-6 py-16">
      <div class="mb-8 flex items-baseline justify-between">
        <p class="tech-label">selected systems</p>
        <a href="/projects" class="font-mono text-sm text-fg-dim transition-colors hover:text-signal">
          view all →
        </a>
      </div>
      <ul class="grid gap-px bg-line sm:grid-cols-3">
        {
          PROJECTS.filter((p) => p.status === 'featured')
            .slice(0, 3)
            .map((p) => (
              <li>
                <a
                  href={`/projects/${p.slug}`}
                  class="group block h-full bg-bg p-6 transition-colors hover:bg-bg-elevated"
                >
                  <h3 class="mb-2 font-mono text-sm text-fg transition-colors group-hover:text-signal">
                    {p.name}
                  </h3>
                  <p class="text-sm text-fg-dim">{p.summary}</p>
                </a>
              </li>
            ))
        }
      </ul>
    </div>
  </section>
</PageLayout>