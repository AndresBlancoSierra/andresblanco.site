---
import PageLayout from '../layouts/PageLayout.astro';
import { SITE, PROJECTS } from '../lib/profile';
import { ConstellationField } from '../components/three/ConstellationField';
---

<PageLayout
  path="/"
  title={SITE.name}
  description={`${SITE.headline} — ${SITE.tagline}`}
>
  <!-- HERO -->
  <section class="relative isolate flex min-h-[78vh] items-center overflow-hidden border-b border-line">
    <div
      class="absolute inset-0 -z-10 opacity-90"
      aria-hidden="true"
    >
      <ConstellationField client:visible />
    </div>

    <div class="mx-auto w-full max-w-6xl px-6 py-24">
      {/* status line — system/online */}
      <p class="tech-label--signal mb-6 flex items-center gap-2">
        <span class="h-1.5 w-1.5 rounded-full bg-ok" aria-hidden="true" />
        system / online · {new Date().getUTCFullYear()}
      </p>

      <h1 class="font-mono text-4xl leading-tight tracking-tight text-fg sm:text-6xl">
        {SITE.name}
      </h1>

      <p class="mt-4 font-mono text-base tracking-wide text-fg-muted sm:text-lg">
        <span class="text-signal">$</span> {SITE.headline}
      </p>

      <p class="mt-8 max-w-xl border-l-2 border-line pl-4 text-lg leading-relaxed text-fg-muted">
        {SITE.tagline}
        <span class="text-fg"> I build complete systems — from C++ drivers and
        Arduino firmware to Whisper/CLIP pipelines and React frontends — and
        document how they work.</span>
      </p>

      <div class="mt-10 flex flex-wrap items-center gap-3">
        <a
          href="/projects"
          class="inline-flex items-center gap-2 border border-line-strong bg-bg-elevated px-5 py-2.5 font-mono text-sm tracking-wide text-fg transition-colors hover:border-signal hover:text-signal"
        >
          <span class="text-fg-dim" aria-hidden="true">[</span> explore projects
          <span class="text-fg-dim" aria-hidden="true">]</span>
        </a>
        <a
          href="/resume"
          class="inline-flex items-center gap-2 px-5 py-2.5 font-mono text-sm tracking-wide text-fg-dim transition-colors hover:text-signal"
        >
          resume <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- QUICK FACTS -->
  <section class="border-b border-line">
    <div class="mx-auto grid max-w-6xl gap-px bg-line sm:grid-cols-3">
      <div class="bg-bg p-6">
        <p class="tech-label mb-2">education</p>
        <p class="font-mono text-sm text-fg-muted">
          B.S. Systems Engineering — Universidad EAN
        </p>
      </div>
      <div class="bg-bg p-6">
        <p class="tech-label mb-2">focus</p>
        <p class="font-mono text-sm text-fg-muted">
          Software · Cloud · Security · Linux
        </p>
      </div>
      <div class="bg-bg p-6">
        <p class="tech-label mb-2">verification</p>
        <p class="font-mono text-sm text-fg-muted">
          6 featured projects · 198+ automated tests
        </p>
      </div>
    </div>
  </section>

  <!-- FEATURED PROJECTS PREVIEW -->
  <section class="mx-auto max-w-6xl px-6 py-16">
    <div class="mb-8 flex items-baseline justify-between">
      <h2 class="font-mono text-2xl tracking-tight text-fg">Selected systems</h2>
      <a href="/projects" class="font-mono text-sm text-fg-dim transition-colors hover:text-signal">
        all projects →
      </a>
    </div>

    <ul class="grid gap-px bg-line sm:grid-cols-2">
      {
        PROJECTS.filter((p) => p.status === 'featured')
          .slice(0, 4)
          .map((project, i) => (
            <li>
              <a
                href={`/projects/${project.slug}`}
                class="group block h-full bg-bg p-6 transition-colors hover:bg-bg-elevated"
              >
                <div class="mb-4 flex items-center justify-between font-mono text-xs text-fg-faint">
                  <span>{String(i + 1).padStart(2, '0')}</span>
                  <span>{project.year}</span>
                </div>
                <h3 class="mb-2 font-mono text-lg text-fg transition-colors group-hover:text-signal">
                  {project.name}
                </h3>
                <p class="mb-4 text-sm leading-relaxed text-fg-dim">
                  {project.summary}
                </p>
                <p class="font-mono text-xs text-fg-faint">
                  {project.tech.join(' · ')}
                </p>
              </a>
            </li>
          ))
      }
    </ul>
  </section>
</PageLayout>