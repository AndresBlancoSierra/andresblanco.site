---
import PageLayout from '../layouts/PageLayout.astro';
import {
  SITE,
  EDUCATION,
  LEADERSHIP,
  PROJECTS,
  SKILLS,
  HONORS,
  LANGUAGES,
} from '../lib/profile';
---

<PageLayout
  path="/resume"
  title="Resume"
  description={`Resume of ${SITE.name} — Systems Engineering student, software engineer and documenter.`}
>
  <section class="mx-auto max-w-4xl px-6 pt-28">
    <div class="mb-10 flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="tech-label mb-4">resume / cv</p>
        <h1 class="font-mono text-3xl tracking-tight text-fg sm:text-4xl">Resume</h1>
      </div>
      <a
        href="/resume.pdf"
        download
        class="inline-flex items-center gap-2 border border-line-strong bg-bg-elevated px-4 py-2.5 font-mono text-sm text-fg transition-colors hover:border-signal hover:text-signal"
      >
        <span aria-hidden="true">↓</span> download pdf
      </a>
    </div>

    <!-- contact -->
    <div class="mb-12 grid gap-3 font-mono text-sm sm:grid-cols-3">
      <div class="panel p-4">
        <p class="tech-label mb-2">location</p>
        <p class="text-fg-muted">{SITE.location}</p>
      </div>
      <div class="panel p-4">
        <p class="tech-label mb-2">email</p>
        <a href={`mailto:${SITE.email}`} class="break-all text-fg-muted transition-colors hover:text-signal">
          {SITE.email}
        </a>
      </div>
      <div class="panel p-4">
        <p class="tech-label mb-2">github</p>
        <a href={SITE.github} target="_blank" rel="noopener noreferrer" class="break-all text-fg-muted transition-colors hover:text-signal">
          github.com/{SITE.githubHandle}
        </a>
      </div>
    </div>

    <!-- education -->
    <section class="mb-12">
      <h2 class="tech-label mb-5">education</h2>
      <div class="panel p-5">
        <div class="flex flex-wrap items-baseline justify-between gap-2">
          <p class="font-mono text-base text-fg">
            {EDUCATION.degree} {EDUCATION.area}
          </p>
          <p class="font-mono text-xs text-fg-faint">{EDUCATION.start} — {EDUCATION.end}</p>
        </div>
        <p class="mt-1 text-sm text-fg-dim">{EDUCATION.institution} · {EDUCATION.location}</p>
        <p class="mt-3 text-sm text-fg-dim">{EDUCATION.note}</p>
      </div>
    </section>

    <!-- leadership -->
    <section class="mb-12">
      <h2 class="tech-label mb-5">leadership</h2>
      <ul class="space-y-px">
        {
          LEADERSHIP.map((item) => (
            <li class="panel p-5">
              <div class="flex flex-wrap items-baseline justify-between gap-2">
                <p class="font-mono text-sm text-fg">{item.role}</p>
                <p class="font-mono text-xs text-fg-faint">{item.year}</p>
              </div>
              <p class="mt-1 text-sm text-fg-dim">{item.org}</p>
              <p class="mt-2 text-sm leading-relaxed text-fg-muted">{item.description}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- projects -->
    <section class="mb-12">
      <h2 class="tech-label mb-5">selected projects</h2>
      <ul class="space-y-px">
        {
          PROJECTS.filter((p) => p.status === 'featured').map((p) => (
            <li class="panel p-5">
              <div class="flex flex-wrap items-baseline justify-between gap-2">
                <p class="font-mono text-sm text-fg">
                  <a href={`/projects/${p.slug}`} class="transition-colors hover:text-signal">
                    {p.name}
                  </a>
                </p>
                <p class="font-mono text-xs text-fg-faint">{p.year}</p>
              </div>
              <p class="mt-2 text-sm leading-relaxed text-fg-muted">{p.summary}</p>
              <p class="mt-3 font-mono text-xs text-fg-faint">{p.tech.join(' · ')}</p>
              {p.metrics.length > 0 && (
                <p class="mt-2 font-mono text-xs text-ok">{p.metrics.join(' · ')}</p>
              )}
            </li>
          ))
        }
      </ul>
    </section>

    <!-- technical skills -->
    <section class="mb-12">
      <h2 class="tech-label mb-5">technical skills</h2>
      <dl class="grid gap-px bg-line sm:grid-cols-2">
        {
          SKILLS.map((group) => (
            <div class="bg-bg p-5">
              <dt class="font-mono text-xs uppercase tracking-widest text-signal">{group.label}</dt>
              <dd class="mt-2 text-sm leading-loose text-fg-dim">{group.details.join(' · ')}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <!-- honors & languages -->
    <section class="mb-12 grid gap-8 md:grid-cols-2">
      <div>
        <h2 class="tech-label mb-5">honors</h2>
        <ul class="space-y-2">
          {
            HONORS.map((h) => (
              <li class="panel p-4">
                <p class="font-mono text-sm text-fg">{h.title}</p>
                {h.detail && <p class="mt-1 text-xs text-fg-dim">{h.detail}</p>}
              </li>
            ))
          }
        </ul>
      </div>
      <div>
        <h2 class="tech-label mb-5">languages</h2>
        <ul class="space-y-2">
          {
            LANGUAGES.map((l) => (
              <li class="panel p-4">
                <p class="font-mono text-sm text-fg">{l.language}</p>
                <p class="mt-1 text-xs text-fg-dim">{l.level}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>
  </section>
</PageLayout>